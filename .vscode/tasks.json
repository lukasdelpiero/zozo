{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ZoZo: publicar na prévia (testes)",
      "detail": "Usuários não veem. Endereço: zozo-previa.zozo-finance-app.workers.dev",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/api/publicar.ps1",
        "previa"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "ZoZo: publicar em produção",
      "detail": "Usuários veem. Pede para digitar PUBLICAR no terminal.",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/api/publicar.ps1",
        "producao"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "ZoZo: rodar no computador",
      "detail": "http://127.0.0.1:8787 (demonstração: /?mock=1)",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/api/dev/servidor_local.py"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ZoZo: testes automáticos",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "${workspaceFolder}/api/tests"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}